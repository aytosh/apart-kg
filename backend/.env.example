DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production-use-long-random-string"
PORT=3000
UPLOAD_DIR="./uploads"
# Через запятую. По умолчанию сервер сам допускает localhost:3000 и Live Server :5500
CLIENT_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# reCAPTCHA (https://www.google.com/recaptcha/admin) — без ключей проверка на сервере отключена
# RECAPTCHA_VERSION=v2 — чекбокс на форме; по умолчанию v3 (невидимая, score)
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_VERSION="v3"

# Google Sign-In: OAuth 2.0 Client ID (Web application), в Authorized JavaScript origins — origin сайта
GOOGLE_CLIENT_ID=""

# Facebook Login: App ID и App Secret (на сервере /auth/facebook по accessToken)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Деплой из админ-панели: GitHub repository_dispatch (URL + PAT)
# Пример URL: https://api.github.com/repos/OWNER/REPO/dispatches
DEPLOY_WEBHOOK_URL=""
DEPLOY_WEBHOOK_SECRET=""

# Платежи (этап 1: sandbox/demo, этап 2: реальный провайдер)
PAYMENT_PROVIDER="DEMO"
PAYMENT_WEBHOOK_SECRET="replace-on-production"

# Web Push: сгенерируйте через `npm run vapid:generate` и подставьте сюда
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@apart.kg"

# Сохранённые поиски: интервал проверки новых объявлений (минут)
SAVED_SEARCH_INTERVAL_MINUTES=10

# Автоперевод объявлений (i18n). Без ключей возвращается исходный текст.
DEEPL_API_KEY=""
GOOGLE_TRANSLATE_KEY=""

# Feature-flags. JSON, перетирает значения по умолчанию.
# Пример: FEATURE_FLAGS={"liveViewing":false,"wechat":true}
FEATURE_FLAGS=""

# Курсы валют для переключателя в шапке (KGS / USD / EUR / CNY / RUB).
# JSON: { base: "KGS", rates: { KGS:1, USD:87.5, EUR:95, CNY:12.1, RUB:0.94 } }.
# По умолчанию используются значения, прошитые в код.
CURRENCY_RATES=""
