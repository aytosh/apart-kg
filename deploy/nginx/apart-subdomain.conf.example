# Пример: сайт Apart на поддомене, webhook Telegram-бота на том же корневом домене.
# Замените apart.example.com, example.com и порты (3000 — Apart, 8080 — бот).
#
# sudo ln -s /etc/nginx/sites-available/apart /etc/nginx/sites-enabled/
# sudo nginx -t && sudo systemctl reload nginx

# --- Apart.kg (HTTPS на поддомене) ---
server {
    listen 443 ssl http2;
    server_name apart.example.com;

    ssl_certificate     /etc/letsencrypt/live/apart.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/apart.example.com/privkey.pem;

    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# --- Telegram webhook на основном домене (бот слушает 8080, путь /webhook) ---
server {
    listen 443 ssl http2;
    server_name example.com www.example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    location /webhook {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Остальное на этом домене — по вашей схеме (лендинг, редирект и т.д.)
}
