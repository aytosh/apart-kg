{
  "name": "apartmant",
  "private": true,
  "description": "Недвижимость КР — веб + API",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev --prefix backend\" \"npm run watch --prefix frontend\"",
    "dev:api": "npm run dev --prefix backend",
    "dev:web": "npm run watch --prefix frontend",
    "start": "npm start --prefix backend",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "db:push": "npm run db:push --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "vapid:generate": "npm run vapid:generate --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
