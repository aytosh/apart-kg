.detail .gallery { width: 100%; height: 480rpx; }
.detail .gallery image { width: 100%; height: 100%; }
.detail .body { padding: 24rpx; background: #ffffff; }
.detail .title { font-size: 36rpx; font-weight: 700; }
.detail .meta { color: #66708a; margin-top: 6rpx; font-size: 26rpx; }
.detail .price { color: #1aad19; font-weight: 700; font-size: 40rpx; margin: 14rpx 0; }
.detail .desc { font-size: 28rpx; line-height: 1.5; margin: 12rpx 0 24rpx; }
.detail .owner, .detail .qr-block { background: #f6f7fb; border-radius: 12rpx; padding: 18rpx 24rpx; margin-top: 24rpx; }
.detail .qr { width: 320rpx; height: 320rpx; margin-top: 12rpx; }
