.toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #ffffff;
}

.toolbar .picker {
  padding: 14rpx 24rpx;
  background: #f6f7fb;
  border-radius: 8rpx;
}

.toolbar input {
  flex: 1;
  background: #f6f7fb;
  padding: 14rpx 24rpx;
  border-radius: 8rpx;
}

.toolbar button {
  background: #1aad19;
  color: #fff;
  font-size: 28rpx;
  padding: 8rpx 24rpx;
}

.empty {
  text-align: center;
  color: #66708a;
  padding: 80rpx 0;
}
